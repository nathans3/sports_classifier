# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.Python

# ─── Virtual Environments ────────────────────────────────────────────────────
venv/
env/
.venv/
.env

# ─── Data (images are re-downloadable, keep out of git) ──────────────────────
data/basketball/
data/soccer/
# Keep the directory structure tracked
!data/basketball/.gitkeep
!data/soccer/.gitkeep

# ─── Models (large binary files, re-trainable) ───────────────────────────────
*.pkl
models/*.png
# Keep the models/ directory tracked
!models/.gitkeep

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# ─── VS Code (comment out if you want to share editor settings) ───────────────
# .vscode/

# ─── Misc ────────────────────────────────────────────────────────────────────
*.swp
*.swo
*.log
